# ============================================================================
# GraphCoder provider configuration
#
# 快速开始：填入任一一组 API 配置即可。GraphCoder 支持：
#   - OpenAI 兼容接口（OpenAI / DeepSeek / Kimi / 智谱 / 通义 / vLLM / OneAPI...）
#   - Anthropic Claude
#   - Google Gemini
#   - Ollama 本地模型
#   - 任意自定义 OpenAI 兼容端点（也可在 Web / CLI 中新增，无需改代码）
# ============================================================================

# ---- 方式一：OpenAI 兼容（最通用）----
API_BASE_URL=https://api.openai.com/v1
API_KEY=your-api-key-here
MODEL_NAME=gpt-4o

# 旧别名（保留兼容，二选一即可）
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---- 方式二：使用内置 provider（通过 ACTIVE_PROVIDER 选择）----
# 可选值: openai / anthropic / gemini / ollama / deepseek / moonshot / zhipu / qwen / stepfun
ACTIVE_PROVIDER=

# 各 provider 的密钥（按需填入）
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
STEPFUN_API_KEY=

# ---- 生成参数 ----
TEMPERATURE=0.7
MAX_TOKENS=16384

# ---- 应用设置 ----
GRAPHCODER_HOME=          # 数据目录，默认 ~/.graphcoder
GRAPHCODER_RUNTIME_PYTHON= # app-server 运行 Python（默认使用当前 Python）
GRAPHCODER_RUNTIME_DEBUG=  # 设为 1 时透传运行时 stderr（调试）
LOG_LEVEL=INFO
DEBUG=false
