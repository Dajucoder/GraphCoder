# LLM provider configuration
# Works with OpenAI and most OpenAI-compatible gateways.
API_BASE_URL=https://api.openai.com/v1
API_KEY=your-api-key-here
MODEL_NAME=gpt-4o-mini

# OpenAI SDK / LangChain-compatible aliases.
# Keep these in sync with API_BASE_URL and API_KEY when using those clients.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here

# Generation settings
TEMPERATURE=0.2
MAX_TOKENS=4096

# Application settings
LOG_LEVEL=INFO
DEBUG=false
